<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client Action for Pulse HR Gamified Dashboard -->
    <record id="action_pulse_dashboard" model="ir.actions.client">
        <field name="name">Pulse HR Dashboard</field>
        <field name="tag">pulse_hr.dashboard</field>
    </record>

    <!-- Root Menu Item for Pulse HR -->
    <menuitem id="menu_pulse_hr_root"
              name="Pulse HR"
              sequence="10"/>

    <!-- Dashboard Menu (Default action on clicking Pulse HR) -->
    <menuitem id="menu_pulse_hr_dashboard"
              name="Dashboard"
              parent="menu_pulse_hr_root"
              action="action_pulse_dashboard"
              sequence="1"/>

    <!-- Employees Menu -->
    <menuitem id="menu_pulse_hr_employees"
              name="Employees"
              parent="menu_pulse_hr_root"
              action="hr.open_view_employee_list_my"
              sequence="2"/>

    <!-- Attendances Menu -->
    <menuitem id="menu_pulse_hr_attendances"
              name="Attendances"
              parent="menu_pulse_hr_root"
              action="hr_attendance.hr_attendance_action"
              sequence="3"/>

    <!-- Time Off Menu -->
    <menuitem id="menu_pulse_hr_leaves"
              name="Time Off"
              parent="menu_pulse_hr_root"
              action="hr_holidays.hr_leave_action_action_approve_department"
              sequence="4"/>
</odoo>
