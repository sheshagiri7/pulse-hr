<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Adds the Login ID field to the employee form view -->
    <record id="pulse_hr_employee_form_inherit" model="ir.ui.view">
        <field name="name">pulse.hr.employee.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='job_title']" position="after">
                <field name="login_id" readonly="1"/>
                <field name="temp_password" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
