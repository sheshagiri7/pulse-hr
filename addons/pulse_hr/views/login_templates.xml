<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Restyled Odoo Login Page for Pulse HR -->
    <template id="pulse_login_layout" inherit_id="web.login" name="Pulse HR Restyled Login">
        <xpath expr="//form" position="replace">
            <div class="pulse-login-container">
                <!-- Floating background ambient glowing elements -->
                <div class="pulse-ambient-orb pulse-orb-1"></div>
                <div class="pulse-ambient-orb pulse-orb-2"></div>

                <div class="pulse-login-card">
                    <!-- Brand Header -->
                    <div class="pulse-brand-header">
                        <div class="pulse-logo-badge">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
                            </svg>
                        </div>
                        <h1 class="pulse-brand-title">PULSE<span class="pulse-gradient-text">HR</span></h1>
                        <p class="pulse-brand-tagline">Gamified Human Capital Platform</p>
                    </div>

                    <!-- Authentic Odoo Login Form -->
                    <form class="pulse-login-form oe_login_form" role="form" t-attf-action="/web/login" method="post" onsubmit="this.action = '/web/login' + location.hash">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                        <!-- Login Error / Notification Messages -->
                        <p class="alert alert-danger" t-if="error" role="alert">
                            <t t-esc="error"/>
                        </p>
                        <p class="alert alert-warning" t-if="message" role="status">
                            <t t-esc="message"/>
                        </p>

                        <!-- Username / Login Field -->
                        <div class="pulse-form-group">
                            <label for="login" class="pulse-form-label">
                                <svg class="pulse-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                                Login ID / Email
                            </label>
                            <input type="text" name="login" t-att-value="login" id="login" required="required" autofocus="autofocus" capitalize="off" placeholder="Enter Login ID (e.g. hr_officer)" class="pulse-form-input form-control"/>
                        </div>

                        <!-- Password Field -->
                        <div class="pulse-form-group">
                            <label for="password" class="pulse-form-label">
                                <svg class="pulse-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                                Password
                            </label>
                            <input type="password" name="password" id="password" required="required" autocomplete="current-password" placeholder="••••••••••••" class="pulse-form-input form-control"/>
                        </div>

                        <input type="hidden" name="redirect" t-att-value="redirect"/>

                        <!-- Action Submit Button -->
                        <div class="pulse-form-actions">
                            <button type="submit" class="pulse-btn-primary">
                                <span>Sign In to Pulse</span>
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                    <polyline points="12 5 19 12 12 19"></polyline>
                                </svg>
                            </button>
                        </div>

                        <!-- Info Footer (No signup link, employees created by HR) -->
                        <div class="pulse-login-footer">
                            <span class="pulse-security-badge">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                </svg>
                                HR Provisioned Account Only
                            </span>
                        </div>
                    </form>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
