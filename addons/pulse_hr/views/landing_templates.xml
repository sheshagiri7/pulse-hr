            <!-- Embedded Guaranteed Motion & Radar Scan Keyframes -->
            <style>
                .pulse-radar-scanline {
                    position: absolute;
                    top: 0; left: 0; right: 0;
                    height: 2px;
                    background: linear-gradient(90deg, transparent 0%, rgba(56, 189, 248, 0.2) 20%, rgba(99, 102, 241, 0.8) 50%, rgba(56, 189, 248, 0.2) 80%, transparent 100%);
                    box-shadow: 0 0 15px rgba(99, 102, 241, 0.6);
                    opacity: 0.6;
                    animation: radarScanline 7s linear infinite;
                    pointer-events: none;
                    z-index: 3;
                }

                @keyframes radarScanline {
                    0% { transform: translateY(-50px); opacity: 0; }
                    10% { opacity: 0.7; }
                    90% { opacity: 0.7; }
                    100% { transform: translateY(100vh); opacity: 0; }
                }

                .pulse-ambient-orb { position: absolute; border-radius: 50%; filter: blur(140px); opacity: 0.38; animation: auraBreathe 10s ease-in-out infinite alternate; }
                .pulse-hero-orb-1 { width: 640px; height: 640px; background: radial-gradient(circle, #6366F1 0%, rgba(99,102,241,0) 70%); top: -10%; left: 15%; }
                .pulse-hero-orb-2 { width: 540px; height: 540px; background: radial-gradient(circle, #38BDF8 0%, rgba(56,189,248,0) 70%); bottom: -15%; right: 10%; animation-delay: -5s; }
                .pulse-hero-orb-3 { width: 480px; height: 480px; background: radial-gradient(circle, #8B5CF6 0%, rgba(139,92,246,0) 70%); top: 35%; left: -10%; animation-delay: -2.5s; }
                .pulse-hero-orb-4 { width: 400px; height: 400px; background: radial-gradient(circle, #0EA5E9 0%, rgba(14,165,233,0) 70%); bottom: 20%; left: 45%; animation-delay: -7.5s; }
                @keyframes auraBreathe { 0% { transform: scale(1) translate(0, 0); opacity: 0.32; } 50% { transform: scale(1.18) translate(40px, -30px); opacity: 0.55; } 100% { transform: scale(0.90) translate(-30px, 30px); opacity: 0.35; } }

                .pulse-ribbon-1 { animation: ribbonFlow1 14s ease-in-out infinite alternate; }
                .pulse-ribbon-2 { animation: ribbonFlow2 18s ease-in-out infinite alternate; }
                @keyframes ribbonFlow1 { 0% { transform: translate(0, 0) rotate(0deg); opacity: 0.30; } 50% { transform: translate(60px, -45px) rotate(6deg); opacity: 0.50; } 100% { transform: translate(-45px, 40px) rotate(-5deg); opacity: 0.32; } }
                @keyframes ribbonFlow2 { 0% { transform: translate(0, 0) rotate(0deg); opacity: 0.25; } 50% { transform: translate(-50px, 50px) rotate(-6deg); opacity: 0.45; } 100% { transform: translate(40px, -35px) rotate(5deg); opacity: 0.28; } }

                .card-attendance { animation: floatCardVertical 3.8s ease-in-out infinite alternate !important; }
                .card-leave { animation: floatCardRotate 5s ease-in-out infinite alternate !important; }
                .card-id { animation: floatCardDiagonal 6s ease-in-out infinite alternate !important; }
                @keyframes floatCardVertical { 0% { transform: translateY(0px); } 100% { transform: translateY(-22px); } }
                @keyframes floatCardDiagonal { 0% { transform: translate(0px, 0px); } 100% { transform: translate(-18px, 18px); } }
                @keyframes floatCardRotate { 0% { transform: translateY(0px) rotate(0deg); } 100% { transform: translateY(-18px) rotate(3.5deg); } }

                .pulse-glow-wave-line { stroke-dasharray: 300 1300; stroke-dashoffset: 1600; animation: wavePulseTravel 3.2s linear infinite !important; }
                @keyframes wavePulseTravel { 0% { stroke-dashoffset: 1600; } 100% { stroke-dashoffset: -300; } }
            </style>
        </head>
