<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pulse_hr.PulseDashboard">
        <div class="pulse-dash-wrapper">
            <!-- Header Section -->
            <div class="pulse-dash-header">
                <div class="pulse-header-main">
                    <div class="pulse-header-title">
                        <div class="pulse-badge-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                            </svg>
                        </div>
                        <div>
                            <h2 class="pulse-title">Pulse Dashboard</h2>
                            <p class="pulse-subtitle">
                                Welcome back, <strong class="pulse-text-highlight"><t t-esc="state.currentUserName"/></strong>! Here is today's live team activity.
                            </p>
                        </div>
                    </div>

                    <!-- View Mode Switcher -->
                    <div class="pulse-view-switcher">
                        <button t-att-class="'pulse-switch-btn ' + (state.currentView === 'employee' ? 'active' : '')"
                                t-on-click="() => this.setView('employee')">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                            Employee View
                        </button>
                        <button t-if="state.isHrManager"
                                t-att-class="'pulse-switch-btn ' + (state.currentView === 'hr' ? 'active' : '')"
                                t-on-click="() => this.setView('hr')">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="7" height="7"></rect>
                                <rect x="14" y="3" width="7" height="7"></rect>
                                <rect x="14" y="14" width="7" height="7"></rect>
                                <rect x="3" y="14" width="7" height="7"></rect>
                            </svg>
                            HR Manager View
                        </button>
                    </div>
                </div>
            </div>

            <!-- Gamified Stats Top Bar -->
            <div class="pulse-stats-grid">
                <!-- Streak Stat Card -->
                <div class="pulse-stat-card pulse-card-streak">
                    <div class="pulse-stat-header">
                        <span class="pulse-stat-label">Attendance Streak</span>
                        <div class="pulse-stat-icon-wrapper pulse-flame-glow">
                            <!-- Tabler Flame Icon -->
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 12c2 -2.96 0 -7 -1 -8c0 3.038 -1.773 4.741 -3 6c-1.226 1.26 -2 3.24 -2 5a7 7 0 1 0 14 0c0 -1.532 -.928 -2.74 -2 -4c-1 2.5 -2 3 -4 1z"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="pulse-stat-value">
                        <span class="pulse-counter-text"><t t-esc="state.metrics.user_streak || 5"/></span>
                        <span class="pulse-unit">Days 🔥</span>
                    </div>
                    <div class="pulse-stat-footer">
                        <div class="pulse-streak-bar-container">
                            <div class="pulse-streak-bar-fill" t-attf-style="width: {{ Math.min(100, (state.metrics.user_streak / 7) * 100) }}%"></div>
                        </div>
                        <span class="pulse-stat-note">Streak active! Keep up the momentum.</span>
                    </div>
                </div>

                <!-- Leave Balance Progress Stat Card -->
                <div class="pulse-stat-card pulse-card-leave">
                    <div class="pulse-stat-header">
                        <span class="pulse-stat-label">Annual Leave Balance</span>
                        <div class="pulse-stat-icon-wrapper pulse-ring-glow">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                        </div>
                    </div>
                    <div class="pulse-stat-value">
                        <span class="pulse-counter-text"><t t-esc="state.metrics.user_leave_remaining || 16"/></span>
                        <span class="pulse-unit">/ 20 Days Left</span>
                    </div>
                    <div class="pulse-stat-footer">
                        <!-- Progress Bar -->
                        <div class="pulse-progress-track">
                            <div class="pulse-progress-fill" t-attf-style="width: {{ state.metrics.user_leave_pct || 80 }}%"></div>
                        </div>
                        <span class="pulse-stat-note"><t t-esc="state.metrics.user_leave_pct || 80"/>% remaining balance</span>
                    </div>
                </div>

                <!-- Team Attendance Rate Stat Card -->
                <div class="pulse-stat-card pulse-card-team">
                    <div class="pulse-stat-header">
                        <span class="pulse-stat-label">Team Pulse Today</span>
                        <div class="pulse-stat-icon-wrapper pulse-bolt-glow">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#6366F1" stroke-width="2">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="pulse-stat-value">
                        <span class="pulse-counter-text"><t t-esc="state.metrics.attendance_rate || 0"/>%</span>
                        <span class="pulse-unit">Present</span>
                    </div>
                    <div class="pulse-stat-footer">
                        <div class="pulse-pill-group">
                            <span class="pulse-pill pulse-pill-present"><t t-esc="state.metrics.present_count || 0"/> Present</span>
                            <span class="pulse-pill pulse-pill-absent"><t t-esc="state.metrics.absent_count || 0"/> Absent</span>
                            <span class="pulse-pill pulse-pill-leave"><t t-esc="state.metrics.leave_count || 0"/> On Leave</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Controls: Filter Tabs & Search Bar -->
            <div class="pulse-controls-bar">
                <div class="pulse-tabs">
                    <button t-att-class="'pulse-tab-btn ' + (state.currentTab === 'all' ? 'active' : '')"
                            t-on-click="() => this.setTab('all')">
                        All <span class="pulse-tab-badge"><t t-esc="state.employees.length"/></span>
                    </button>
                    <button t-att-class="'pulse-tab-btn ' + (state.currentTab === 'present' ? 'active' : '')"
                            t-on-click="() => this.setTab('present')">
                        <span class="pulse-dot pulse-dot-present"></span> Present
                        <span class="pulse-tab-badge"><t t-esc="state.metrics.present_count || 0"/></span>
                    </button>
                    <button t-att-class="'pulse-tab-btn ' + (state.currentTab === 'absent' ? 'active' : '')"
                            t-on-click="() => this.setTab('absent')">
                        <span class="pulse-dot pulse-dot-absent"></span> Absent
                        <span class="pulse-tab-badge"><t t-esc="state.metrics.absent_count || 0"/></span>
                    </button>
                    <button t-att-class="'pulse-tab-btn ' + (state.currentTab === 'leave' ? 'active' : '')"
                            t-on-click="() => this.setTab('leave')">
                        <span class="pulse-dot pulse-dot-leave"></span> On Leave
                        <span class="pulse-tab-badge"><t t-esc="state.metrics.leave_count || 0"/></span>
                    </button>
                </div>

                <div class="pulse-search-box">
                    <svg class="pulse-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" placeholder="Search employee, ID, department..."
                           t-att-value="state.searchQuery"
                           t-on-input="(ev) => this.onSearchInput(ev)"/>
                </div>
            </div>

            <!-- Employee Kanban Cards Grid -->
            <div class="pulse-kanban-grid" t-att-data-view="state.currentView">
                <t t-if="filteredEmployees.length === 0">
                    <div class="pulse-empty-state">
                        <div class="pulse-empty-icon">🔍</div>
                        <h3>No employees found</h3>
                        <p>Try adjusting your search query or filter tab.</p>
                    </div>
                </t>

                <t t-foreach="filteredEmployees" t-as="emp" t-key="emp.id">
                    <div class="pulse-employee-card" t-on-click="() => this.openEmployeeDetail(emp.id)">
                        <!-- Card Header & Status Dot -->
                        <div class="pulse-card-top">
                            <div class="pulse-avatar-wrapper">
                                <img class="pulse-avatar-img" t-att-src="emp.avatar_url" t-att-alt="emp.name"
                                     onerror="this.onerror=null; this.src='/web/static/img/placeholder.png';"/>
                                <span t-att-class="'pulse-status-dot pulse-status-' + emp.status" t-att-title="emp.status"></span>
                            </div>
                            <div class="pulse-id-badge">
                                <t t-esc="emp.login_id"/>
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="pulse-card-body">
                            <h4 class="pulse-emp-name">
                                <t t-esc="emp.name"/>
                                <span t-if="emp.is_current_user" class="pulse-you-badge">YOU</span>
                            </h4>
                            <p class="pulse-emp-title"><t t-esc="emp.job_title"/></p>
                            <p class="pulse-emp-dept"><t t-esc="emp.department"/></p>
                        </div>

                        <!-- Gamified Card Badges -->
                        <div class="pulse-card-gamification">
                            <!-- Streak Flame Badge -->
                            <div class="pulse-mini-badge pulse-streak-badge" title="Attendance Streak">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2.5">
                                    <path d="M12 12c2 -2.96 0 -7 -1 -8c0 3.038 -1.773 4.741 -3 6c-1.226 1.26 -2 3.24 -2 5a7 7 0 1 0 14 0c0 -1.532 -.928 -2.74 -2 -4c-1 2.5 -2 3 -4 1z"></path>
                                </svg>
                                <span><t t-esc="emp.streak"/>d Streak</span>
                            </div>

                            <!-- Leave Progress Bar -->
                            <div class="pulse-mini-leave-track" title="Remaining Leave Balance">
                                <div class="pulse-mini-leave-fill" t-attf-style="width: {{ emp.leave_pct }}%"></div>
                            </div>
                        </div>

                        <!-- Manager Specific Info in HR View -->
                        <t t-if="state.currentView === 'hr'">
                            <div class="pulse-hr-view-extra">
                                <div class="pulse-extra-row">
                                    <span>Work Email:</span>
                                    <strong><t t-esc="emp.work_email || 'n/a'"/></strong>
                                </div>
                                <div class="pulse-extra-row">
                                    <span>Leaves Taken:</span>
                                    <strong><t t-esc="emp.leave_taken"/> / <t t-esc="emp.leave_allocated"/> Days</strong>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
